{
  "schemaVersion": 1,
  "id": "ggzlouoptimizer",
  "version": "${version}",
  "name": "GGZlouOptimizer",
  "description": "Русский Minecraft Fabric мод для оптимизации и визуальных улучшений.",
  "authors": [
    "GGZlou"
  ],
  "contact": {
    "sources": "https://github.com/GGZlou/GGZlouOptimizer"
  },
  "license": "CC0-1.0",
  "icon": "assets/ggzlouoptimizer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ggzlou.optimizer.GGZlouOptimizer"
    ],
    "client": [
      "com.ggzlou.optimizer.client.GGZlouOptimizerClient"
    ]
  },
  "mixins": [
